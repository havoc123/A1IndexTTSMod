<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- ★公开仓库纪律：BepInEx 核心路径走环境变量/构建参数，不写死某台机器的目录。
         本 harness 只在有 BepInEx 核心 DLL 的机器上完整构建；没有时下面
         Condition="Exists(...)" 的 ItemGroup 整体跳过（纯托管断言仍可跑）。 -->
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(A1_BEPINEX_CORE)/0Harmony.dll</HarmonyPath>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(A1_BEPINEX_CORE)</BepInExCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="AsrLifecycle/**/*.cs" />
    <Compile Include="..\src\NpcVoiceResolver.cs" Link="NpcVoiceResolver.cs" />
    <Compile Include="..\src\VoiceStyle.cs" Link="VoiceStyle.cs" />
    <Compile Include="..\src\StyleEnvelopeCodec.cs" Link="StyleEnvelopeCodec.cs" />
    <Compile Include="..\src\StyleStore.cs" Link="StyleStore.cs" />
    <Compile Include="..\src\SpeechTextFilter.cs" Link="SpeechTextFilter.cs" />
    <Compile Include="..\src\PcmVolumeWaveProvider.cs" Link="PcmVolumeWaveProvider.cs" />
    <Compile Include="..\src\PromptEnhancer.cs" Link="PromptEnhancer.cs" />
    <Compile Include="..\src\PresetVoiceStyles.cs" Link="PresetVoiceStyles.cs" />
    <Compile Include="..\src\PersuadeSpeechPolicy.cs" Link="PersuadeSpeechPolicy.cs" />
    <EmbeddedResource Include="..\config\preset-voice-styles.zh-CN.json">
      <LogicalName>A1IndexTTSMod.preset-voice-styles.zh-CN.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="..\docs\prompts\npc-emotion-enhancement.zh-CN.md">
      <LogicalName>A1IndexTTSMod.npc-emotion-enhancement.zh-CN.md</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(HarmonyPath)')">
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)</HintPath>
    </Reference>
    <Content Include="$(BepInExCoreDir)\*.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCoreDir)\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="NAudio.Core">
      <HintPath>..\src\bin\Release\net6.0\NAudio.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- ★本 harness 编译进 src/ 下使用 HarmonyLib/BepInEx 的真实源码，因此
       只能在装有 BepInEx 核心的机器上构建。环境变量缺失时给出明确错误，
       而不是抛出一个看不懂的 HintPath 找不到文件。 -->
  <Target Name="RequireBepInExCore" BeforeTargets="Build" Condition="'$(A1_BEPINEX_CORE)' == ''">
    <Error Text="请设置环境变量 A1_BEPINEX_CORE 指向游戏目录下的 BepInEx\core（本 harness 需要真实的 Harmony/BepInEx DLL）。" />
  </Target>
</Project>
